$C = "../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 480, Height: 522);

    #Title {
      $C.@Title {
        @Text = %server.customUI.ArcaneRelayConfig.title;
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Group #ErrorScreen {
        LayoutMode: Top;
        Visible: false;

        Label {
          Text: %server.customUI.ArcaneRelayConfig.failedToLoadDataMessage;
          Anchor: (Bottom: 16);
          Style: (...$C.@DefaultLabelStyle, RenderBold: true, TextColor: #ff6666);
        }
      }

      Group #MainContent {
        LayoutMode: Top;

        // Row 1: Trigger Distance and Target Distance
        Group {
          LayoutMode: Left;
          Anchor: (Bottom: 8);

          Group {
            LayoutMode: Top;
            FlexWeight: 1;
            Anchor: (Right: 8);

            Label {
              Anchor: (Bottom: 5);
              Style: (...$C.@DefaultLabelStyle, Wrap: true, FontSize: 16, TextColor: #94969a, RenderBold: true);
              Text: %server.customUI.ArcaneRelayConfig.triggerDistanceTitle;
            }

            TextField #TriggerDistanceInput {
              Anchor: (Height: 38);
              Style: $C.@DefaultInputFieldStyle;
              PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle;
              Background: $C.@InputBoxBackground;
              Padding: (Horizontal: 10);
            }
          }

          Group {
            LayoutMode: Top;
            FlexWeight: 1;

            Label {
              Anchor: (Bottom: 5);
              Style: (...$C.@DefaultLabelStyle, Wrap: true, FontSize: 16, TextColor: #94969a, RenderBold: true);
              Text: %server.customUI.ArcaneRelayConfig.targetDistanceTitle;
            }

            TextField #TargetDistanceInput {
              Anchor: (Height: 38);
              Style: $C.@DefaultInputFieldStyle;
              PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle;
              Background: $C.@InputBoxBackground;
              Padding: (Horizontal: 10);
            }
          }
        }

        // Row 2: Pusher Range and Puller Range
        Group {
          LayoutMode: Left;
          Anchor: (Bottom: 8);

          Group {
            LayoutMode: Top;
            FlexWeight: 1;
            Anchor: (Right: 8);

            Label {
              Anchor: (Bottom: 5);
              Style: (...$C.@DefaultLabelStyle, Wrap: true, FontSize: 16, TextColor: #94969a, RenderBold: true);
              Text: %server.customUI.ArcaneRelayConfig.pusherRangeTitle;
            }

            TextField #PusherRangeInput {
              Anchor: (Height: 38);
              Style: $C.@DefaultInputFieldStyle;
              PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle;
              Background: $C.@InputBoxBackground;
              Padding: (Horizontal: 10);
            }
          }

          Group {
            LayoutMode: Top;
            FlexWeight: 1;

            Label {
              Anchor: (Bottom: 5);
              Style: (...$C.@DefaultLabelStyle, Wrap: true, FontSize: 16, TextColor: #94969a, RenderBold: true);
              Text: %server.customUI.ArcaneRelayConfig.pullerRangeTitle;
            }

            TextField #PullerRangeInput {
              Anchor: (Height: 38);
              Style: $C.@DefaultInputFieldStyle;
              PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle;
              Background: $C.@InputBoxBackground;
              Padding: (Horizontal: 10);
            }
          }
        }

        // Row 3: Breaker Damage
        Group {
          LayoutMode: Top;
          Anchor: (Bottom: 16);

          Label {
            Anchor: (Bottom: 5);
            Style: (...$C.@DefaultLabelStyle, Wrap: true, FontSize: 16, TextColor: #94969a, RenderBold: true);
            Text: %server.customUI.ArcaneRelayConfig.breakerDamageTitle;
          }

          TextField #BreakerDamageInput {
            Anchor: (Height: 38);
            Style: $C.@DefaultInputFieldStyle;
            PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle;
            Background: $C.@InputBoxBackground;
            Padding: (Horizontal: 10);
          }
        }

        // Separator
        Group {
          Anchor: (Bottom: 8, Height: 1);
          Background: #5e512c;
        }

        // Row 4: Non-Movable List
        Group {
          LayoutMode: Top;
          Anchor: (Bottom: 8);

          Label {
            Anchor: (Bottom: 5);
            Style: (...$C.@DefaultLabelStyle, Wrap: true, FontSize: 16, TextColor: #94969a, RenderBold: true);
            Text: %server.customUI.ArcaneRelayConfig.moveableBlacklistTitle;
          }

          TextField #NonMovableListInput {
            Anchor: (Height: 38);
            Style: $C.@DefaultInputFieldStyle;
            PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle;
            Background: $C.@InputBoxBackground;
            Padding: (Horizontal: 10);
          }
        }

        // Row 5: Non-Rotatable List
        Group {
          LayoutMode: Top;
          Anchor: (Bottom: 16);

          Label {
            Anchor: (Bottom: 5);
            Style: (...$C.@DefaultLabelStyle, Wrap: true, FontSize: 16, TextColor: #94969a, RenderBold: true);
            Text: %server.customUI.ArcaneRelayConfig.rotatableBlacklistTitle;
          }

          TextField #NonRotatableBlacklistInput {
            Anchor: (Height: 38);
            Style: $C.@DefaultInputFieldStyle;
            PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle;
            Background: $C.@InputBoxBackground;
            Padding: (Horizontal: 10);
          }
        }
      }

      // Separator
      Group {
        Anchor: (Bottom: 16, Height: 1);
        Background: #5e512c;
      }
      
      // Buttons
      Group {
        LayoutMode: Left;
        Anchor: (Height: 44);

        $C.@TextButton #CancelButton {
          Text: %server.customUI.ArcaneRelayConfig.cancel;
          Style: $C.@CancelTextButtonStyle;
          FlexWeight: 1;
          Anchor: (Right: 8);
        }

        $C.@TextButton #SaveButton {
          Text: %server.customUI.ArcaneRelayConfig.save;
          FlexWeight: 1;
        }
      }
    }
  }
}
